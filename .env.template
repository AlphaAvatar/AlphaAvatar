# Environment for a source checkout: copy it, fill in what the selected YAML reads, and name
# the copy with ENV_FILE (default .env), e.g. cp .env.template .env.dev
# A variable already set in the environment wins. A line left as NAME= sets NAME empty, which
# also hides a credential `alphaavatar setup` stored under it: keep unused lines commented.
# Never commit the filled-in copy.

# === LiveKit: session transport ===
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# === Model providers ===
# OpenAI: the examples' models, embeddings, memory/persona tasks and speech
OPENAI_API_KEY=
# Google (provider: google): environment memory in examples mm/ and roles/demo.yaml
GOOGLE_API_KEY=
# VoiceAI speech (voice.tts.plugin: voiceai)
# VOICEAI_API_KEY=
# provider: openrouter / anthropic
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# A server of your own: setup names its key ALPHAAVATAR_SERVER_KEY_<hash> after its URL,
# see docs/cli/setup.md#credentials

# === Qdrant: only when memory/persona keep their vectors there; LanceDB needs none ===
# QDRANT_URL=
# QDRANT_API_KEY=

# === Tools ===
# DeepResearch through Tavily
# TAVILY_API_KEY=
# An MCP server's token, read in its YAML as ${oc.env:GITHUB_PAT}
# GITHUB_PAT=

# === Host (optional) ===
# Application home (settings, bundles, Avatar workspaces, model cache); an absolute path
# ALPHAAVATAR_HOME=/var/lib/alphaavatar
# Session limit when host.execution.max_session_seconds is unset: default 1800, 0 for none
# ALPHAAVATAR_MAX_SESSION_SECONDS=1800
# No model downloads; remote providers are still called
# ALPHAAVATAR_MODEL_OFFLINE=1
